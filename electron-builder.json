{
  "appId": "com.biscoitdistributor.inventory",
  "productName": "Inventory Manager",
  "copyright": "Copyright © Al-Rehman Biscuits",
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "directories": {
    "output": "dist-electron",
    "buildResources": "assets"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "server/**/*",
    "package.json"
  ],
  "asar": true,
  "asarUnpack": [
    "**/node_modules/sql.js/dist/*.wasm",
    "**/node_modules/sql.js/**/*.wasm"
  ],
  "extraResources": [
    {
      "from": "assets",
      "to": "assets",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/icon.ico",
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Inventory Manager",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false
  }
}
